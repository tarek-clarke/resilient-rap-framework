@@ -26,6 +26,22 @@ DISABLE_WARNING_POP
 
 #include "misc/wrap_thrust.hpp"
 
+// CUDA 13's Thrust removed these pre-C++17 compatibility base classes.
+// Aer 0.17.2 still derives a few local function objects from them.
+namespace thrust {
+template <typename Arg, typename Result> struct unary_function {
+  using argument_type = Arg;
+  using result_type = Result;
+};
+
+template <typename Arg1, typename Arg2, typename Result>
+struct binary_function {
+  using first_argument_type = Arg1;
+  using second_argument_type = Arg2;
+  using result_type = Result;
+};
+} // namespace thrust
