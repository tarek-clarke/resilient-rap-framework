# Hugging Face model configuration
# v9 generative reconciler
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
QWEN_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Optional Hugging Face API token
HF_TOKEN=

# Maximum tokens for reasoning context (default: 2048)
LLM_MAX_REASONING_TOKENS=2048

# Device mapping: auto, cuda, mps, cpu (default: auto)
HF_DEVICE_MAP=auto

# Precision: auto, float16, bfloat16, float32 (default: auto)
HF_TORCH_DTYPE=auto

# Attention implementation: auto, flash_attention_2, sdpa, eager, none
HF_ATTN_IMPL=auto

# Quantization flags (mutually exclusive with full precision)
HF_LOAD_4BIT=false
HF_LOAD_8BIT=false

# Override local model path (leave empty for hub download)
HF_LOCAL_MODEL_PATH=

# -----------------------------------------------------------------------
# VLQ (Ostrava) QPU — EuroHPC / LEXIS QaaS credentials
# Copy this block into your LOCAL .env file (never commit real values).
# -----------------------------------------------------------------------
# Your EuroHPC project ID (received via email after project approval).
VLQ_PROJECT=

# VLQ resource queue assigned to your project (e.g. VLQ-CZ or VLQ-EU).
VLQ_RESOURCE=

# Optional cloud providers. Never commit actual credentials.
COHERE_API_KEY=
QISKIT_IBM_TOKEN=
